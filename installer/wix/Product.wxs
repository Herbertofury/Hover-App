<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Hover" Manufacturer="Hover" Version="0.1.0" UpgradeCode="11111111-1111-1111-1111-111111111111">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Hover is already installed." />
    <Feature Id="Main" Title="Hover" Level="1">
      <ComponentGroupRef Id="HoverFiles" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Hover" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="HoverFiles" Directory="INSTALLFOLDER">
      <Component Id="HoverExe">
        <File Source="..\\..\\target\\release\\hover.exe" />
      </Component>
      <Component Id="BrowserHostExe">
        <File Source="..\\..\\target\\release\\hover-browser-host.exe" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>